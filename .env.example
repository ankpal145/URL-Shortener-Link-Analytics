# Copy to .env for local Postgres runs, or paste into Render "Environment Variables".
# NEVER commit a real .env with filled-in secrets.

# --- App ---
# Public base URL used to build "shortUrl" in responses.
# Locally: leave unset to fall back to http://localhost:8080
APP_BASE_URL=https://your-service.onrender.com

# Salt for SHA-256(ip) in analytics. Generate with:  openssl rand -base64 48
# Rotating this value invalidates historical unique-visitor counts.
APP_IP_HASH_SALT=replace-with-openssl-rand-output

# --- Database (Postgres, e.g. Neon or Render Postgres) ---
# JDBC form (must start with "jdbc:"). Drop channel_binding=require from any
# Neon-provided string - it's a libpq param and the JDBC driver rejects it.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# Optional: explicit Hibernate dialect (auto-detected otherwise).
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# --- Runtime ---
# Render injects PORT automatically; local runs default to 8080.
# PORT=8080
